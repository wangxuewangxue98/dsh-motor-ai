{
  "name": "dsh-motor-ai",
  "version": "1.2.4",
  "description": "电机设计 L1/L2 完整版（RMxprt + Motor-CAD），依赖共享核心 @wangxue98/dsh-motor-ai-core",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./lib/*": "./lib/*.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2 <0.2.0",
      "node": ">=22.0.0"
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/run_unit_tests.mjs",
    "test:unit": "node scripts/run_unit_tests.mjs",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests --passWithNoTests"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@wangxue98/dsh-motor-ai-core": "^1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "file:./dev-stubs/dsh-tools",
    "jest": "^29.7.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "dsh",
    "plugin",
    "motor",
    "design",
    "l1",
    "l2",
    "rmxprt",
    "motor-cad"
  ],
  "author": {
    "name": "wangxuewangxue98",
    "url": "https://github.com/wangxuewangxue98"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxuewangxue98/dsh-motor-ai.git"
  },
  "bugs": {
    "url": "https://github.com/wangxuewangxue98/dsh-motor-ai/issues"
  },
  "homepage": "https://github.com/wangxuewangxue98/dsh-motor-ai#readme",
  "files": [
    "manifest.json",
    "index.mjs",
    "cordis.patch.yml",
    "lib/",
    "tools/",
    "models/",
    "scripts/",
    "skills/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "package.json",
    "!**/*.bak*",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=22"
  }
}
